NODE_ENV=development
PROCESS_ROLE=all            # api | worker | all
PORT=3000
LOG_LEVEL=log
API_BASE_URL=http://192.168.1.2:3000
MOBILE_DEEP_LINK_SCHEME=socialpublisher
PROVIDER_MODE=fake          # fake | live

DATABASE_URL=postgresql://postgres:dev@localhost:5433/social_publisher
DIRECT_DATABASE_URL=postgresql://postgres:dev@localhost:5433/social_publisher
PGBOSS_DATABASE_URL=postgresql://postgres:dev@localhost:5433/social_publisher

JWT_ACCESS_SECRET=           # at least 32 random characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

TOKEN_ENCRYPTION_KEYS={"1":"base64-encoded-32-bytes"}
TOKEN_ENCRYPTION_ACTIVE_VERSION=1

STORAGE_ENDPOINT=http://localhost:8333
STORAGE_PUBLIC_ENDPOINT=http://192.168.1.2:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sp-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
