{
  "name": "@sp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "create-owner": "tsx scripts/create-owner.ts",
    "smoke": "tsx scripts/smoke-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sp/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.2.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.2",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
